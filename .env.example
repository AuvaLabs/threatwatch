# ThreatWatch Configuration
# Copy this file to .env and customize as needed

# Site domain (used in RSS feed links)
SITE_DOMAIN=localhost:8098

# How many days of articles to keep (default: 7)
FEED_CUTOFF_DAYS=7
# Reject upstream timestamps beyond this tolerance.
MAX_FUTURE_MINUTES=15
# Maximum retained articles from one named source. Set 0 to disable balancing.
MAX_ARTICLES_PER_SOURCE=250
MAX_ARTICLES_PER_FEED=250

# HTTP server port
PORT=8098

# Optional: NewsAPI.org — security news feed (free tier: 100 req/day)
# NEWSAPI_KEY=your-newsapi-key
# NEWSAPI_INTERVAL=1800   # seconds between calls (default 1800 = 30 min)

# Optional: cached IOC corroboration for evidence-gated hunt packages.
# Provider calls run only in the pipeline and are bounded per cycle.
# THREATFOX_AUTH_KEY=your-threatfox-auth-key
# URLHAUS_AUTH_KEY=your-urlhaus-auth-key
# HUNT_ENRICHMENT_MAX_LOOKUPS=40
# HUNT_ENRICHMENT_TTL_HOURS=24

# AI provider: Kimi (OpenAI-compatible coding endpoint)
LLM_API_KEY=your-kimi-api-key
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=kimi-for-coding
LLM_PROVIDER=openai
# Daily nominal spend allowed for billable providers.
DAILY_BUDGET_USD=2.00
# Provider route names known to be free or covered outside usage billing.
# Example for a free Gemini primary and free Groq fallback:
# LLM_ZERO_COST_PROVIDERS=primary,fallback

# Optional AuvaLabs private Model Services route. Put the bearer token in the
# gitignored .secrets/modelservices.env file as MODEL_SERVICES_API_KEY=...
# MODEL_SERVICES_ENV_FILE=.secrets/modelservices.env
MODEL_SERVICES_URL=https://modelservices.auvalabs.com/techmodel/servicesapi/chat
MODEL_SERVICES_MODEL=gpt-6-luna
MODEL_SERVICES_TIMEOUT=240
MODEL_SERVICES_REASONING_EFFORT=low
MODEL_SERVICES_CALLERS=briefing,top_stories
MODEL_SERVICES_DAILY_CALL_LIMIT=48
MODEL_SERVICES_CALLER_COOLDOWN_SECONDS=3600

# Optional preferred native Claude provider. Keep the real key in the shared
# AuvaLabs secret file, never in this repository.
# ANTHROPIC_ENV_FILE=.secrets/anthropic.env
# ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_BRIEFING_MODEL=claude-sonnet-5-5
ANTHROPIC_TOP_STORIES_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=60
# OpenAI-compatible fallback models used when native Claude is unavailable.
BRIEFING_MODEL=kimi-for-coding
TOP_STORIES_MODEL=kimi-for-coding

# Optional: request timeout in seconds. Defaults to 120 for Kimi (reasoning
# models can be slower) and 30 for other providers.
# LLM_TIMEOUT=120
# Maximum articles enriched per cycle and delay between uncached batches.
# The delay protects provider request-per-minute quotas during large backfills.
# MAX_SUMMARIES_PER_RUN=150
# SUMMARY_BATCH_SIZE=5
# SUMMARY_BATCH_DELAY_SECONDS=5
# SUMMARY_MAX_TOKENS=1600

# Optional independent OpenAI-compatible fallbacks. They are tried for every
# AI capability when the primary provider fails or retires a model.
# FEATHERLESS_API_KEY=your-fallback-key
# FEATHERLESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FEATHERLESS_MODEL=gemini-flash-lite-latest
# FEATHERLESS_TIMEOUT=60
# BRIEFING_FALLBACK_API_KEY=your-second-fallback-key
# BRIEFING_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
# BRIEFING_FALLBACK_MODEL=gpt-oss-120b
# BRIEFING_FALLBACK_TIMEOUT=60

# Optional: Telegram channel — KEV per-CVE alerts + briefing dispatcher
# TELEGRAM_BOT_TOKEN=123456:AA-...
# TELEGRAM_CHAT_ID=@your_channel
# TELEGRAM_MIN_LEVEL=CRITICAL              # CRITICAL | ELEVATED | MODERATE | …
# TELEGRAM_COOLDOWN_HOURS=6
# TELEGRAM_KEV_MAX_AGE_DAYS=14             # suppress KEV alerts older than N days
                                           # (0 disables the filter)

# Optional: Webhook alerts (Slack or generic)
# WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_MIN_CONF=80

# Optional: Server-side watchlist persistence
# WATCHLIST_WRITE_ENABLED=true
# WATCHLIST_TOKEN=your-secret-token

# Optional: CORS — restrict /api/health and /api/watchlist to a specific origin
# CORS_ORIGIN=https://threatwatch.auvalabs.com
